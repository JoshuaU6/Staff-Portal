    "@clerk/shared": "^4.10.0",
    "@workspace/api-zod": "file:../../lib/api-zod",
    "@workspace/db": "file:../../lib/db",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "cross-env": "^10.1.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5",
    "http-proxy-middleware": "^4.0.0",
    "multer": "^2.1.1",
    "pino": "^9",
    "pino-http": "^10"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.3.3",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "^3"
