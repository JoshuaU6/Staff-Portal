# ============================================================
# MTC Group — Production Environment Variables
# Copy to .env.prod and fill in real values before deploying.
# NEVER commit .env.prod to source control.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# RDS PostgreSQL connection string
DATABASE_URL=postgresql://mtc_user:CHANGE_ME@rds-endpoint.us-east-1.rds.amazonaws.com:5432/mtcdb?sslmode=require

# ── Auth ─────────────────────────────────────────────────────
# Clerk production keys — obtain from clerk.com dashboard (production instance)
# CLERK_PUBLISHABLE_KEY / VITE_CLERK_PUBLISHABLE_KEY are baked into the
# staff-portal Docker image at build time (Vite compile-time constant).
# They are also set as runtime env on the api-server ECS task.
CLERK_PUBLISHABLE_KEY=pk_live_CHANGE_ME
CLERK_SECRET_KEY=sk_live_CHANGE_ME
VITE_CLERK_PUBLISHABLE_KEY=pk_live_CHANGE_ME

# Session signing secret — generate with: openssl rand -hex 64
SESSION_SECRET=CHANGE_ME_64_HEX_CHARS

# ── Server ───────────────────────────────────────────────────
NODE_ENV=production
PORT=8080

# ── AWS ──────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# ECR registry prefix (output from Terraform)
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com

# S3 bucket for document storage (output from Terraform)
S3_DOCUMENTS_BUCKET=mtc-documents-prod

# ── Redis (session cache / rate-limiting — future use) ────────
REDIS_URL=redis://elasticache-endpoint.cache.amazonaws.com:6379

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://mtc-groups.com,https://www.mtc-groups.com
